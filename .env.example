# Stripe -> https://dashboard.stripe.com/apikeys (use test keys first: sk_test_...)
STRIPE_SECRET_KEY=
# Stripe -> Developers > Webhooks > add endpoint {SITE_URL}/api/stripe/webhook (event: checkout.session.completed)
STRIPE_WEBHOOK_SECRET=
# Public https URL of the site (used for Stripe redirects and product images)
SITE_URL=http://localhost:3000
PORT=3000
# Flat shipping fee in USD cents (e.g. 899 = $8.99). Leave empty for free shipping.
SHIPPING_CENTS=
# Free shipping above this subtotal in USD cents (optional)
FREE_SHIPPING_OVER_CENTS=
# Required to delete reviews via the admin API. Use a long random string.
ADMIN_TOKEN=
# Local testing only: gives unpriced products a $49.90 test price. Ignored when NODE_ENV=production.
DEV_PLACEHOLDER_PRICES=

# Manual payments shown at checkout (hidden while empty). Overrides site.config.json "payments".
ZELLE_ID=
ZELLE_NAME=
VENMO_HANDLE=
APPLECASH_ID=

# Order emails (optional). Gmail: turn on 2-Step Verification, then Google Account > Security > App passwords.
# Without these, orders still work and are shown in the admin app, but no emails are sent.
SMTP_USER=
SMTP_PASS=
# Where new-order emails go. Defaults to the "email" in site.config.json.
OWNER_EMAIL=
